---
layout: base.njk
title: Продукти
description: Инвертори, батерии и панели — подбрани продукти за фотоволтаични системи за дома и бизнеса.
---

<main>
  <section class="section-padding bg-white pb-8 md:pb-10">
    <div class="container-custom">
      <p class="text-sm uppercase tracking-wide text-brand-blue/80 mb-2">Продукти</p>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-brand-blue">Всички продукти</h1>
      <p class="mt-4 text-brand-blue/80 max-w-3xl leading-relaxed">
        По-долу са групирани по тип. За наличности, срокове и оферта — свържете се с нас.
      </p>
    </div>
  </section>

  {# Must sit outside the hero <section>: sticky is clipped by its ancestor; parent must span the scrollable list #}
  {% if productCategories.length %}
  <nav class="sticky z-30 top-[6.25rem] md:top-[6.85rem] border-b border-brand-blue/10 bg-white/95 py-3 shadow-sm backdrop-blur-sm" aria-label="Скок към тип продукт">
    <div class="container-custom min-w-0">
      <div class="flex flex-nowrap gap-2 overflow-x-auto overflow-y-hidden pb-1 scrollbar-hide md:flex-wrap md:overflow-visible md:pb-0">
      {% for c in productCategories %}
      <a href="#{{ c.slug }}" class="inline-flex shrink-0 items-center rounded-2xl border border-brand-accent/30 bg-brand-accent/15 px-3 py-1.5 text-xs font-semibold text-brand-blue sm:px-4 sm:py-2 sm:text-sm hover:bg-brand-accent/25 hover:border-brand-accent/45 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent/40 focus-visible:ring-offset-2 transition-colors">
        {{ c.title }}
      </a>
      {% endfor %}
      </div>
    </div>
  </nav>
  {% endif %}

  {% for c in productCategories %}
  {% set items = productsByCategory[c.slug] | default([]) %}
  <section id="{{ c.slug }}" class="section-padding {% if loop.index0 % 2 == 0 %}bg-brand-buttercream{% else %}bg-white{% endif %} scroll-mt-[10rem]">
    <div class="container-custom">
      {% set categoryPreview = items[0] if items and items.length else null %}
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">{{ c.title }}</h2>
          {% if c.description %}<p class="mt-2 max-w-2xl text-brand-blue/80 leading-relaxed">{{ c.description }}</p>{% endif %}
        </div>
        {% if categoryPreview and categoryPreview.image and categoryPreview.image.local %}
        <div class="hidden md:block shrink-0">
          <img src="{{ ('/assets/images/' ~ categoryPreview.image.local) | url }}" alt="{{ categoryPreview.image.alt | default(c.title) }}" class="h-20 w-auto rounded-xl object-cover opacity-90" loading="lazy">
        </div>
        {% endif %}
      </div>

      {% if items.length == 0 %}
      <p class="mt-8 rounded-3xl border border-brand-blue/10 bg-white p-6 text-brand-blue/80">Няма продукти в тази група.</p>
      {% else %}
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {% for p in items %}
        <a href="{{ ('/produkti/' ~ p.categorySlug ~ '/' ~ p.slug ~ '/') | url }}" class="group rounded-3xl overflow-hidden border border-brand-blue/10 bg-white shadow-sm hover:shadow-lg transition">
          <div class="p-4">
            <div class="rounded-2xl overflow-hidden bg-brand-buttercream aspect-square">
              {% if p.image and p.image.local %}
              <img src="{{ ('/assets/images/' ~ p.image.local) | url }}" alt="{{ p.image.alt | default(p.name) }}" class="w-full h-full object-cover" loading="lazy">
              {% else %}
              <div class="w-full h-full bg-gradient-to-br from-brand-blue/10 to-brand-accent/10"></div>
              {% endif %}
            </div>
            <h3 class="mt-4 text-sm font-bold text-brand-blue group-hover:underline line-clamp-2">{{ p.name }}</h3>
            {% if p.overview %}<p class="mt-2 text-xs text-brand-blue/80 leading-relaxed line-clamp-2">{{ p.overview }}</p>{% endif %}
            <div class="mt-4 flex items-center justify-between gap-2">
              <span class="text-xs font-semibold text-brand-blue">
                {% if p.price and p.price.displayEur %}
                  {{ p.price.displayEur }} €{% if p.price.displayBgn %} · {{ p.price.displayBgn }} лв{% endif %} <span class="font-normal text-brand-blue/70">с ДДС</span>
                {% else %}
                  <span class="text-brand-blue/70">Цена по запитване</span>
                {% endif %}
              </span>
              <span class="inline-flex rounded-xl bg-brand-accent px-3 py-1.5 text-xs font-semibold text-brand-blue group-hover:opacity-95">Детайли</span>
            </div>
          </div>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endfor %}

  <section class="section-padding bg-white border-t border-brand-blue/10">
    <div class="container-custom text-center">
      {% from "macros/ui.njk" import button %}
      <p class="text-brand-blue/80 mb-4">Нужна консултация за подбор на компоненти?</p>
      {{ button('Свържете се с нас', '/kontakti/', 'primary') }}
    </div>
  </section>
</main>
