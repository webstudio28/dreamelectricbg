<section class="pt-8 md:pt-10 pb-16 md:pb-24">
  <div class="container-custom">
    <div class="relative rounded-3xl overflow-hidden min-h-[320px] md:min-h-[280px] flex flex-col md:flex-row md:items-center md:justify-between gap-8 p-8 md:p-12">
      <div class="absolute inset-0 z-0">
        <img src="{{ ('/assets/images/' + home.footerCta.image) | url }}" alt="" class="w-full h-full object-cover" loading="lazy">
        <div class="absolute inset-0 bg-black/70" aria-hidden="true"></div>
      </div>
      <div class="relative z-10 text-white max-w-xl">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-2">{{ home.footerCta.title }}</h2>
        <p class="text-white/90">{{ home.footerCta.description }}</p>
      </div>
      <div class="relative z-10">
        {% from "macros/ui.njk" import button %}
        {{ button(home.footerCta.buttonLabel, home.footerCta.buttonUrl, 'primary') }}
      </div>
    </div>
  </div>
</section>
