<section class="section-padding pb-8 md:pb-10 bg-brand-buttercream">
  <div class="container-custom">
    {% from "macros/ui.njk" import sectionHeader, icon, button %}
    {% set c = home.contact %}
    {{ sectionHeader('', c.title, c.subtitle) }}

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white rounded-3xl shadow-lg p-6 md:p-8 text-brand-blue">
        <div class="flex items-center gap-3 mb-3">
          {{ icon('phone') }}
          <div class="font-semibold">Телефон</div>
        </div>
        <a href="tel:{{ site.contact.phone | replace(' ', '') }}" class="text-brand-blue/90 hover:underline">{{ site.contact.phone }}</a>
      </div>

      <div class="bg-white rounded-3xl shadow-lg p-6 md:p-8 text-brand-blue">
        <div class="flex items-center gap-3 mb-3">
          {{ icon('mail') }}
          <div class="font-semibold">Имейл</div>
        </div>
        <a href="mailto:{{ site.contact.email }}" class="text-brand-blue/90 hover:underline">{{ site.contact.email }}</a>
      </div>

      <div class="bg-white rounded-3xl shadow-lg p-6 md:p-8 text-brand-blue">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-5 h-5 rounded-full bg-brand-accent"></span>
          <div class="font-semibold">Viber</div>
        </div>
        {% if site.contact and site.contact.viber %}
          <a href="viber://chat?number={{ site.contact.viber | replace('+','%2B') }}" class="inline-flex items-center justify-center w-full rounded-2xl bg-brand-accent text-brand-blue font-semibold py-3 px-4 hover:opacity-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue/30">Пиши ни във Viber</a>
        {% else %}
          <div class="text-sm text-brand-blue/70">Добавете Viber номер в `site.config.json`.</div>
        {% endif %}
      </div>
    </div>

    <div class="mt-8 flex justify-start">
      {{ button('Към контакти', '/kontakti/', 'secondary') }}
    </div>
  </div>
</section>
