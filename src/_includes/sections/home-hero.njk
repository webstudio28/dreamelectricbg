<section class="relative min-h-[90vh] flex items-center overflow-hidden text-white">
  <div class="absolute inset-0 z-0">
    <img src="{{ ('/assets/images/' + home.hero.image) | url }}" alt="" class="w-full h-full object-cover" fetchpriority="high">
    <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>
  </div>
  <div class="container-custom relative z-10 section-padding w-full">
    <div class="flex flex-col items-start w-full">
      <div class="text-left w-full max-w-2xl lg:max-w-4xl">
        <h1 class="text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-4">{{ home.hero.headline }}</h1>
        <p class="text-lg text-white/90 mb-6">{{ home.hero.paragraph }}</p>

        {% if home.hero.bullets and home.hero.bullets.length %}
        <ul class="space-y-2 text-white/90 mb-8">
          {% for b in home.hero.bullets %}
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-brand-accent font-bold">✓</span>
            <span>{{ b }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        <div class="flex flex-wrap items-center gap-3">
          <a href="{{ home.hero.ctaPrimary.url | url }}" class="inline-flex items-center justify-center rounded-2xl px-10 py-2.5 text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue/50 bg-brand-accent text-brand-blue hover:opacity-95 lg:px-14 lg:py-3 lg:text-base">
            {{ home.hero.ctaPrimary.label }}
          </a>
          <a href="{{ home.hero.ctaSecondary.url | url }}" class="inline-flex items-center justify-center rounded-2xl px-5 py-2.5 text-sm font-semibold transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue/50 bg-white text-brand-blue border-2 border-brand-blue/20 hover:border-brand-blue/40 hover:bg-white/95 lg:px-7 lg:py-3 lg:text-base">
            {{ home.hero.ctaSecondary.label }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
