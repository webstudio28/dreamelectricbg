{% from "macros/ui.njk" import sectionHeader, homeServiceCard %}
<section class="section-padding bg-brand-buttercream overflow-x-hidden max-w-full">
  <div class="container-custom">
    {% set s = home.services %}
    {{ sectionHeader(s.eyebrow, s.title, s.subtitle) }}
  </div>
  <div class="w-full min-w-0 drag-scroll overflow-x-auto pb-2 cursor-grab active:cursor-grabbing select-none scrollbar-hide lg:hidden">
    <div class="flex gap-8 services-strip-inner">
      {% for item in services %}
      {{ homeServiceCard(item, 'flex-shrink-0 w-64 md:w-72') }}
      {% endfor %}
    </div>
  </div>
  <div class="hidden lg:block container-custom">
    <div class="grid grid-cols-4 gap-8">
      {% for item in services %}
      {{ homeServiceCard(item, 'min-w-0') }}
      {% endfor %}
    </div>
  </div>
  <div class="container-custom">
    <div class="flex justify-end pt-6 md:pt-8">
      <a href="{{ '/uslugi/' | url }}" class="text-sm font-semibold text-brand-blue hover:underline">Всички услуги</a>
    </div>
  </div>
</section>
