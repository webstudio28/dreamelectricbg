---
layout: null
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for item in collections.all %}
    {% if item.url and (item.url != '/sitemap.xml') and (item.url != '/robots.txt') and (item.data.eleventyExcludeFromCollections != true) %}
    <url>
      <loc>{{ site.seo.siteUrl }}{{ item.url | url }}</loc>
      <lastmod>{{ buildDate }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>{% if item.url == '/' %}1{% else %}0.8{% endif %}</priority>
    </url>
    {% endif %}
  {% endfor %}
</urlset>
